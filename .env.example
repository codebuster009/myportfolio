# Resend — required by /api/contact
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Database (Neon / Postgres) — use the POOLED connection string in production
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth.js — https://authjs.dev
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub usernames allowed to use /admin
ADMIN_GITHUB_LOGINS=yourgithubhandle

# Public site URL (metadata, RSS, absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Storage (media uploads from admin)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional bucket name (defaults to "media")
# SUPABASE_MEDIA_BUCKET=media

# Vercel Cron (set in Vercel project env; job calls GET /api/cron/publish with this bearer token)
CRON_SECRET=
